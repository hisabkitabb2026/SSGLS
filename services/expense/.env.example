# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expense_service
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_ECHO=False

# Service Configuration
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8002
SERVICE_NAME=expense-service
SERVICE_ENV=development
DEBUG=True

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE_NAME=invoiceshelf_events
RABBITMQ_QUEUE_PREFIX=expense_service

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Metrics Configuration
ENABLE_METRICS=True
METRICS_PORT=8003

# Sentry Configuration (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://invoiceshelf.test
