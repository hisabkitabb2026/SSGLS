# Server
NODE_ENV=development
PORT=8001
SERVICE_NAME=invoicing-microservice
LOG_LEVEL=info

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=invoicing_db
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=24h

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_VHOST=/
RABBITMQ_QUEUE_INVOICE_CREATED=invoice.created
RABBITMQ_QUEUE_INVOICE_UPDATED=invoice.updated
RABBITMQ_QUEUE_INVOICE_DELETED=invoice.deleted

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# Logging
LOG_FORMAT=json
