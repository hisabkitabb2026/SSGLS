# Application Configuration
APP_NAME=Transport Microservice
APP_VERSION=1.0.0
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8006

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/transport_db
DATABASE_ECHO=false

# JWT
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=transport_exchange
RABBITMQ_QUEUE=transport_events

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Metrics
METRICS_ENABLED=true
