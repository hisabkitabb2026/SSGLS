APP_NAME="InvoiceShelf"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://invoiceshelf.example.com

LOG_CHANNEL=stack
LOG_LEVEL=info
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=db.example.com
DB_PORT=3306
DB_DATABASE=invoiceshelf
DB_USERNAME=invoiceshelf
DB_PASSWORD=secure-password-here
DB_LOG_QUERIES=false
DB_SLOW_QUERY_MS=1000

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
FILESYSTEM_DISK=s3

REDIS_HOST=redis.example.com
REDIS_PASSWORD=redis-password-here
REDIS_PORT=6379
REDIS_DB=0

MAIL_DRIVER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=mail-password-here
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="InvoiceShelf"

# File Storage (S3)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=invoiceshelf-media
AWS_URL=https://invoiceshelf-media.s3.amazonaws.com

# PDF Generation (choose: dompdf or gotenberg)
PDF_DRIVER=dompdf
GOTENBERG_URL=http://gotenberg:3000

# Encryption
ENCRYPTION_KEY=base64:your-32-character-base64-key-here

# Rate Limiting
# Customize throttle rates (requests:period in minutes)
THROTTLE_LIMIT=60
THROTTLE_PERIOD=1

# Security
TRUSTED_PROXIES=
SECURE_HEADERS_ENABLED=true
CORS_ALLOWED_ORIGINS=https://invoiceshelf.example.com

# Transport Features
TRANSPORT_ENABLED=true
LORRY_RECEIPT_AUTO_NUMBERING=true
ENABLE_LR_RECEIPT=true
ENABLE_OFFICE_INVOICE=true

# Backup Configuration
BACKUP_DRIVER=s3
BACKUP_LOCATION=s3
BACKUP_DISK=s3
BACKUP_FILENAME_FORMAT=invoiceshelf-{Y-m-d-His}

# AI Configuration (optional)
AI_DRIVER=openai
OPENAI_API_KEY=sk-your-openai-key
OPENAI_ORGANIZATION=your-org-id

# Monitoring & Observability
SENTRY_LARAVEL_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_TRACES_SAMPLE_RATE=0.1

# Logging
LOG_STACK=single,slack
LOG_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your-webhook-url
LOG_SLACK_CHANNEL=#invoiceshelf-errors

# Job Scheduling
SCHEDULE_LOG_LEVEL=info
SUPERVISOR_ENABLED=true

# Timezone & Locale
APP_TIMEZONE=UTC
APP_LOCALE=en

# Security: Session settings
SESSION_LIFETIME=720
SESSION_SECURE_COOKIES=true
SESSION_SAME_SITE=lax

# Security: Authentication
AUTH_PASSWORD_TIMEOUT=1440
AUTH_LOGIN_ATTEMPTS=5
AUTH_LOGIN_DECAY_MINUTES=1

# Cache: Warmup on startup
CACHE_WARMUP_ENABLED=true

# Queue: Processing
QUEUE_RETRY_AFTER=60
QUEUE_TRIES=3
QUEUE_TIMEOUT=60
QUEUE_MAX_ATTEMPTS=10

# Health Check
HEALTH_CHECK_SECRET=your-secret-key
HEALTH_CHECK_ENABLED=true Binary files invoiceshelf and invoiceshelf differ Binary files invoiceshelf-journal and invoiceshelf-journal differ