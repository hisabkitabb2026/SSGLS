###############################################################################
# InvoiceShelf Microservices — Master Environment File
# =============================================================================
# This file provides default values for docker-compose.full.yml.
# Copy to .env and customize as needed for your environment.
#
# IMPORTANT: Change all secrets before deploying to production!
###############################################################################

# ── JWT Secrets (shared across services) ────────────────────────────────────
JWT_SECRET=invoiceshelf-dev-jwt-secret-change-in-production
JWT_REFRESH_SECRET=invoiceshelf-dev-refresh-secret-change-in-production

# ── PostgreSQL (Application Database) ────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=invoiceshelf

# ── Kong API Gateway ────────────────────────────────────────────────────────
KONG_DATABASE=postgres
KONG_PG_USER=kong
KONG_PG_PASSWORD=kong_password
KONG_PG_DATABASE=kong

# ── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=invoiceshelf
RABBITMQ_DEFAULT_PASS=rabbitmq_password
RABBITMQ_DEFAULT_VHOST=/invoiceshelf

# ── Grafana ─────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
